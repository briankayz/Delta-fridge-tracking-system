{
  "expo": {
    "name": "Delta Asset Guard",
    "slug": "delta-asset-guard-beacon",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#082563"
    },
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "Scan the QR code on a cooler beacon.",
        "NSLocationWhenInUseUsageDescription": "Show alerts near you and record where a beacon was installed."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#082563"
      },
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "CAMERA"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "name": "Delta Asset Guard",
      "themeColor": "#082563",
      "backgroundColor": "#082563"
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "Scan the QR code on a cooler beacon."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Show alerts near you and record where a beacon was installed."
        }
      ]
    ]
  }
}
