# Copy to .env and adjust. Never commit .env.

# --- Server ---
PORT=8787
# NODE_ENV=production

# --- Database ---
# Unset = embedded PostgreSQL (PGlite) stored in DATA_DIR. Set for a real server:
# DATABASE_URL=postgres://delta:password@localhost:5432/delta_asset_guard
DATA_DIR=./data/pg

# --- Security ---
# Required in production (32+ random characters). Dev generates one in ./data/.jwt-secret
# JWT_SECRET=
SESSION_HOURS=12
# Browser origins allowed to call the API directly (the web app normally uses its own proxy)
# CORS_ORIGINS=https://assetguard.example.com
# Expo web build of the field app (native apps do not need CORS):
CORS_ORIGINS=http://localhost:8081

# First administrator (created only when no users exist)
# ADMIN_EMAIL=you@delta.co.zw
# ADMIN_PASSWORD=change-me-to-something-long-123

# --- Demo ---
# 1 = seed demo users/stores/virtual coolers and enable the breach simulator
DEMO_MODE=1
DEMO_PASSWORD=Delta-Demo-2026!
# DEMO_FORCE_CURFEW=1

# --- Operations ---
OFFLINE_AFTER_MIN=15
TELEMETRY_RETENTION_DAYS=90

# --- Notifications (optional) ---
# NOTIFY_WEBHOOK_URL=https://...        # Microsoft Teams workflow / Slack / integration endpoint
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_SMS_FROM=+1...
# TWILIO_WHATSAPP_FROM=+1...
