# Copy to deploy.env (never commit it) and fill in. Used by: docker compose --env-file deploy.env up -d
POSTGRES_PASSWORD=
# 32+ random characters, e.g. from: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
ADMIN_EMAIL=
# 10+ characters with letters and numbers; change it after first sign-in
ADMIN_PASSWORD=
APP_PORT=8787
# 1 only for demonstrations
DEMO_MODE=0
# NOTIFY_WEBHOOK_URL=
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_SMS_FROM=
# TWILIO_WHATSAPP_FROM=
